# Copy to .env.local and fill in. Never commit .env.local.
DEEPSEEK_API_KEY=        # https://platform.deepseek.com — planner, extractor, validator, answerer
TAVILY_API_KEY=          # https://tavily.com — web search for the research step
# DEEPSEEK_MODEL=deepseek-v4-pro      # main model (default)
# DEEPSEEK_FAST_MODEL=deepseek-flash  # validation (default)
# DEMO_MODE=1   # answer only from cached searches, pages and model calls (works offline)
# DB_PATH=      # defaults to ./data/insight.db locally, /tmp/insight.db on Vercel
